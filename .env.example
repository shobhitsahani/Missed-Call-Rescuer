# ==============================================================================
# Missed-Call Rescuer Environment Configuration
# ==============================================================================

# --- API Keys & Credentials (SECRETS) ---
# AssemblyAI API key for real-time Streaming STT (v3) and Streaming TTS (v1)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# AssemblyAI default voice model ID (e.g. aai-jane, aai-brian, aai-emma)
ASSEMBLYAI_VOICE_ID=aai-jane
# AssemblyAI streaming speech-to-text model
ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro

# LLM Provider (Fast TTFT: ~300ms using Groq)
# GROQ_API_KEY also works and takes precedence when set.
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b

# --- Origin Validation & Security ---
# Allowed origins for CORS and WebSocket handshake (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3010,https://missed-call-rescuer.vercel.app

# --- Rate Limits & Budget Protection ---
# Maximum simultaneous active voice call sessions
MAX_CONCURRENT_CALLS=2
# Daily total call budget limit
MAX_CALLS_PER_DAY=100
# Maximum call duration before automatic polite wrap-up (seconds)
MAX_CALL_SECONDS=300
# Admin/test routes are open locally. In production they require this token in
# the x-admin-token header. Leave empty in production to disable them.
ADMIN_TOKEN=

# --- Server & Speech Configuration ---
PORT=4000
NODE_ENV=development
STT_PROVIDER=assemblyai
FIRST_CHUNK_MIN_WORDS=6
DB_PATH=./data/app.db

# --- Frontend Base URL (Set in Vercel for web app) ---
# Explicit value always wins. If unset, localhost uses :4000 and HTTPS deploys
# use the hosted Render API.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# --- Owner Notifications (telegram | discord | none) ---
NOTIFY_PROVIDER=none
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_CHAT_ID=123456789
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/token...
DASHBOARD_URL=http://localhost:3010
