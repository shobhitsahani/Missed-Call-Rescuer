{
  "name": "missed-call-rescuer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c auto \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3010",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -n web,api -c auto \"npm run start:web\" \"npm run start:api\"",
    "start:web": "next start -p 3010",
    "start:api": "tsx server/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "next": "16.4.3",
    "openai": "^7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
