{
  "name": "missed-call-rescuer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c auto \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3010",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "concurrently -n web,api -c auto \"npm run start:web\" \"npm run start:api\"",
    "start:web": "next start -p 3010",
    "start:api": "tsx server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-api-base.ts && tsx scripts/test-platform.ts && tsx scripts/test-transcript-format.ts && tsx scripts/test-wav-builder.ts && tsx scripts/test-phone-collection.ts && tsx scripts/test-settings-validation.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:preview": "tsx scripts/test-preview-abort.ts",
    "test:e2e": "tsx scripts/verify-live-voice-workflow.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
